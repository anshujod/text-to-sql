# Postgres bootstrap (consumed directly by the official postgres image)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=t2sql
# Not 5432: a native Postgres install commonly already owns that port.
POSTGRES_PORT=5433

# App roles created by docker/init/01-roles.sh
APP_OWNER_PASSWORD=app_owner_pw
APP_READONLY_PASSWORD=app_readonly_pw

# Consumed by src/t2sql/db/connection.py
DATABASE_URL_OWNER=postgresql://app_owner:app_owner_pw@localhost:5433/t2sql
DATABASE_URL_READONLY=postgresql://app_readonly:app_readonly_pw@localhost:5433/t2sql

# OpenRouter (OpenAI-compatible endpoint) — used from Phase 1.2 onward
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GENERATION_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_DETECTION_MODEL=anthropic/claude-haiku-4.5
